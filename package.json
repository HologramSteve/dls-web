{
  "name": "dls-web",
  "private": true,
  "version": "2.1.6",
  "description": "Web port of Sebastian Lague's Digital Logic Sim (TypeScript + WebGL2, no game engine)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
